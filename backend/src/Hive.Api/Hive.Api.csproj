<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <!-- Build writes the OpenAPI document the frontend generates its typed client from (npm run gen:api). -->
    <OpenApiGenerateDocuments>true</OpenApiGenerateDocuments>
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/../../../frontend/src/api</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name hive-api</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Hive.Infrastructure/Hive.Infrastructure.csproj" />
    <ProjectReference Include="../Hive.Modules.Devices/Hive.Modules.Devices.csproj" />
    <ProjectReference Include="../Hive.Modules.Telemetry/Hive.Modules.Telemetry.csproj" />
    <ProjectReference Include="../Hive.Modules.Events/Hive.Modules.Events.csproj" />
    <ProjectReference Include="../Hive.Modules.Media/Hive.Modules.Media.csproj" />
    <ProjectReference Include="../Hive.Modules.Rules/Hive.Modules.Rules.csproj" />
    <ProjectReference Include="../Hive.Modules.Notify/Hive.Modules.Notify.csproj" />
    <ProjectReference Include="../Hive.Modules.Cluster/Hive.Modules.Cluster.csproj" />
    <ProjectReference Include="../Hive.Modules.Users/Hive.Modules.Users.csproj" />
  </ItemGroup>
</Project>
