  "components": {
    "schemas": {
      "ArmedDto": {
        "required": [
          "armed",
          "updatedAt",
          "updatedBy",
          "cameras"
        ],
        "type": "object",
        "properties": {
          "armed": {
            "type": "boolean"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedBy": {
            "type": [
              "null",
              "string"
            ]
          },
          "cameras": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "ChangePasswordRequest": {
        "required": [
          "currentPassword",
          "newPassword"
        ],
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string"
          },
          "newPassword": {
            "type": "string"
          }
        }
      },
      "CommandDto": {
        "required": [
          "cid",
          "deviceId",
          "name",
          "status",
          "issuedBy",
          "issuedAt",
          "ackAt",
          "ack"
        ],
        "type": "object",
        "properties": {
          "cid": {
            "type": "string"
          },
          "deviceId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "issuedBy": {
            "type": "string"
          },
          "issuedAt": {
            "type": "string",
            "format": "date-time"
          },
          "ackAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "ack": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/JsonElement"
              }
            ]
          }
        }
      },
      "CreateCodeRequest": {
        "required": [
          "deviceId",
          "type",
          "name"
        ],
        "type": "object",
        "properties": {
          "deviceId": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "name": {
            "type": "string"
