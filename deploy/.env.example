# Hive settings. install.sh creates /opt/hive/.env from this file and fills in the passwords.
# Never commit the real .env.
COMPOSE_FILE=compose.yaml:compose.home.yaml

HIVE_VERSION=0.1.0
# Image name prefix: <prefix>-api, <prefix>-web. Images loaded from a tar file use the same names.
HIVE_IMAGES=ghcr.io/knikolaich/village-swarm
HIVE_DATA=/srv/hive
HIVE_TIMEZONE=Europe/Moscow
# Addresses the UI is opened by (HTTPS certificate names), comma separated. install.sh detects them.
HIVE_HOSTS=localhost
HIVE_DEFAULT_SNI=localhost
# Extra addresses for later, e.g. the dacha IP while preparing in the city (install.sh --host).
HIVE_EXTRA_HOSTS=
# Air temperature at the board that counts as overheating, °C.
HIVE_AIR_WARN_C=45

PG_PASSWORD=change-me
MQTT_ADMIN_USER=hive-api
MQTT_ADMIN_PASSWORD=change-me
# Password of the first web user "admin" (only used while there are no users).
AUTH__BOOTSTRAPADMINPASSWORD=

# Backups (spec 10, docs/restore.md). A database dump is made every night at BACKUP_AT and the last seven are kept
# in <HIVE_DATA>/backups/db. For a copy that survives losing the drive, set a restic repository: a folder on another
# drive (RESTIC_REPOSITORY=/repo and BACKUP_REPO_DIR=<that folder on the host>), or rest:https://..., sftp:..., s3:...
# RESTIC_PASSWORD encrypts it: keep it somewhere safe outside the hive, without it the copy cannot be read.
BACKUP_AT=03:00
# Day of the weekly restore check, 1 = Monday ... 7 = Sunday, 0 = never.
BACKUP_VERIFY_DAY=7
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
BACKUP_REPO_DIR=/srv/hive/restic
# Only for an s3: repository (Backblaze B2, Yandex Object Storage ...).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Telegram bot (spec 9). Token from @BotFather; empty disables the bot.
TELEGRAM__TOKEN=
# Endpoints are tried in order. Direct by default; examples for the VPS:
# TELEGRAM__ENDPOINTS__0__PROXY=socks5://vps.example.org:1080
# TELEGRAM__ENDPOINTS__0__PROXYUSER=hive
# TELEGRAM__ENDPOINTS__0__PROXYPASSWORD=
# TELEGRAM__ENDPOINTS__1__BASEURL=https://tg.example.org/secret-path
