# Copy to deploy/.env on the hive (install.sh fills it in). Never commit the real .env.
HIVE_VERSION=0.0.1
HIVE_DATA=/srv/hive
PG_PASSWORD=change-me

# Telegram bot (spec 9). Token from @BotFather; empty disables the bot.
TELEGRAM__TOKEN=
# Endpoints are tried in order. Direct by default; examples for the VPS:
# TELEGRAM__ENDPOINTS__0__PROXY=socks5://vps.example.org:1080
# TELEGRAM__ENDPOINTS__0__PROXYUSER=hive
# TELEGRAM__ENDPOINTS__0__PROXYPASSWORD=
# TELEGRAM__ENDPOINTS__1__BASEURL=https://tg.example.org/secret-path
