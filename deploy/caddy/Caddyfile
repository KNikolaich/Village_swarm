# Hive web front (spec 7.2, 12, 13.2). Baked into the web image; HIVE_HOSTS comes from deploy/.env.
{
	admin off
	# LAN appliance without a public name: certificates from Caddy's own CA.
	# Install /ca.crt once on phones and PCs to get rid of the browser warning.
	local_certs
	skip_install_trust
	# Port 80 is ours (the :80 site below): hornets upload over plain HTTP, no automatic redirect for them.
	auto_https disable_redirects
	# No HTTP/3: Caddy would advertise it (Alt-Svc) but the UDP port is not published, and a browser that trusts
	# the certificate only through an exception can fail the upgrade; the LAN gains nothing from QUIC.
	servers {
		protocols h1 h2
	}
	# The router's site (:8088 below): the address of the visitor comes from the router in X-Forwarded-For.
	# HIVE_ROUTER_IPS narrows who may say so (for example "192.168.10.1/32 10.10.10.1/32").
	servers :8088 {
		protocols h1 h2
		trusted_proxies static {$HIVE_ROUTER_IPS:private_ranges}
		client_ip_headers X-Forwarded-For X-Real-IP
	}
	default_sni {$HIVE_DEFAULT_SNI:localhost}
}

# The api behind every site. X-Hive-External says "came from the internet": only the router's site sets it,
# the others drop it, so a browser at home cannot pretend.
(api) {
	reverse_proxy api:8080 {
		header_up -X-Hive-External
	}
}

(security_headers) {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		X-Frame-Options DENY
		-Server
	}
}

# Plain HTTP: only what hornets need inside the IoT segment (no TLS on ESP32-CAM, spec 4.1): uploads,
# enrollment and over-the-air images (token-checked by the api, MD5-checked by the hornet),
# the CA certificate, and a redirect to HTTPS for everything else.
:80 {
	import security_headers
	@hornet path /api/ingest/* /api/provision/enroll /api/ota/* /healthz
	handle @hornet {
		import api
	}
	handle /ca.crt {
		root * /data/caddy/pki/authorities/local
		rewrite * /root.crt
		header Content-Type application/x-x509-ca-cert
		file_server
	}
	handle {
		redir https://{host}{uri} 308
	}
}

{$HIVE_HOSTS:localhost} {
	tls internal
	import security_headers
	encode zstd gzip

	# Live video (contracts/ipcam.md "Live video"): go2rtc's player socket and frames only, each after the api has said
	# the user is signed in and the stream is one of the cameras'. Nothing else of go2rtc (its API, its page) is reachable.
	@video path /streams/ws /streams/frame.jpeg
	handle @video {
		route {
			forward_auth api:8080 {
				uri /api/video/authorize
				header_up -X-Hive-External
			}
			rewrite /streams/ws /api/ws
			rewrite /streams/frame.jpeg /api/frame.jpeg
			reverse_proxy go2rtc:1984
		}
	}
	handle /streams/* {
		respond 404
	}
	handle /api/* {
		import api
	}
	handle /hubs/* {
		import api
	}
	handle /healthz {
		import api
	}
	handle /readyz {
		import api
	}
	handle /ca.crt {
		root * /data/caddy/pki/authorities/local
		rewrite * /root.crt
		header Content-Type application/x-x509-ca-cert
		file_server
	}
	handle {
		root * /srv/web
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}

# The internet through a Keenetic router (docs/keenetic-access.md). KeenDNS keeps the HTTPS certificate (Let's Encrypt)
# and forwards here over the local network or the WireGuard tunnel. Only the UI and its api: no hornet endpoints,
# no CA certificate, no API docs. Sign-in from here always asks a new device for the Telegram code.
http://:8088 {
	import security_headers
	header Strict-Transport-Security "max-age=31536000"
	encode zstd gzip

	@closed path /api/ingest/* /api/provision/enroll /api/ota/* /swagger* /openapi* /ca.crt
	handle @closed {
		respond 404
	}

	# Live video (contracts/ipcam.md "Live video"): go2rtc's player socket and frames only, each after the api has said
	# the user is signed in and the stream is one of the cameras'. Nothing else of go2rtc (its API, its page) is reachable.
	@video path /streams/ws /streams/frame.jpeg
	handle @video {
		route {
			forward_auth api:8080 {
				uri /api/video/authorize
				header_up X-Hive-External 1
				header_up X-Forwarded-Proto https
				header_up X-Forwarded-For {client_ip}
			}
			rewrite /streams/ws /api/ws
			rewrite /streams/frame.jpeg /api/frame.jpeg
			reverse_proxy go2rtc:1984
		}
	}
	handle /streams/* {
		respond 404
	}
	@api path /api/* /hubs/*
	handle @api {
		reverse_proxy api:8080 {
			header_up X-Hive-External 1
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-For {client_ip}
		}
	}
	handle {
		root * /srv/web
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
