{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://village-swarm.local/contracts/v1/tele-batch.schema.json",
  "title": "vs/v1/dev/{id}/tele/batch (several metrics at once, e.g. after deep sleep)",
  "type": "object",
  "allOf": [{ "$ref": "common.schema.json#/$defs/envelope" }],
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["m", "v"],
        "properties": {
          "m": { "$ref": "common.schema.json#/$defs/segment" },
          "v": { "type": "number" },
          "unit": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "unevaluatedProperties": false
}
