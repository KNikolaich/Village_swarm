{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://village-swarm.local/contracts/v1/tele.schema.json",
  "title": "vs/v1/dev/{id}/tele/{metric}",
  "type": "object",
  "allOf": [{ "$ref": "common.schema.json#/$defs/envelope" }],
  "required": ["value"],
  "properties": {
    "value": { "type": "number" },
    "unit": { "type": "string", "minLength": 1 },
    "sensor": { "type": "string", "minLength": 1 }
  },
  "unevaluatedProperties": false
}
