{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://village-swarm.local/contracts/v1/state.schema.json",
  "title": "vs/v1/dev/{id}/state (retained): current actuator states",
  "type": "object",
  "allOf": [{ "$ref": "common.schema.json#/$defs/envelope" }],
  "required": ["state"],
  "properties": {
    "state": {
      "type": "object",
      "propertyNames": { "$ref": "common.schema.json#/$defs/segment" },
      "additionalProperties": { "type": ["string", "number", "boolean"] }
    }
  },
  "unevaluatedProperties": false
}
