{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://village-swarm.local/contracts/v1/config.schema.json",
  "title": "vs/v1/dev/{id}/config (retained, hive -> hornet). Sections a role does not use are omitted",
  "type": "object",
  "required": [
    "v",
    "rev",
    "name",
    "health_interval_s"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "rev": {
      "type": "integer",
      "minimum": 0
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Human name, may be Cyrillic"
    },
    "health_interval_s": {
      "type": "integer",
      "minimum": 10
    },
    "tele_interval_s": {
      "type": "integer",
      "minimum": 1
    },
    "sleep_s": {
      "type": "integer",
      "description": "Battery hornets: deep sleep this long between readings (wake, send, sleep). 0 or absent: always awake. While asleep the hornet keeps its last status; the hive treats it as lost after several missed wake-ups",
      "anyOf": [
        {
          "const": 0
        },
        {
          "minimum": 60,
          "maximum": 86400
        }
      ]
    },
    "sleep_mode": {
      "enum": [
        "deep",
        "light"
      ],
      "description": "How a hornet with sleep_s > 0 saves power. deep (default): radio and CPU off between readings, disconnects; needs GPIO16 wired to RST on ESP8266. light: stays connected with Wi-Fi power saving and reads every sleep_s; works on any board, saves far less"
    },
    "features": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "thermometer",
          "bme280",
          "relay",
          "heater"
        ]
      },
      "description": "What the hornet is used for (roles meteo, relay, heat). thermometer: DS18B20 on 1-Wire; bme280: BME280 on I2C; relay: a relay switched by commands; heater: that relay heats and the hornet itself keeps failsafe.heater (needs relay and a sensor). Pins of features not listed are left alone. Absent: the role's default (meteo: thermometer, bme280; relay: relay; heat: thermometer, relay, heater)"
    },
    "failsafe": {
      "type": "object",
      "properties": {
        "heater": {
          "type": "object",
          "required": [
            "min_c",
            "max_c",
            "max_on_s"
          ],
          "properties": {
            "min_c": {
              "type": "number"
            },
            "max_c": {
              "type": "number"
            },
            "max_on_s": {
              "type": "integer",
              "minimum": 1
            },
            "sensor": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "guard": {
      "type": "object",
      "properties": {
        "armed": {
          "type": "boolean"
        },
        "cooldown_s": {
          "type": "integer",
          "minimum": 0
        },
        "record_when_disarmed": {
          "type": "boolean"
        },
        "check_photo_every_min": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "camera": {
      "type": "object",
      "properties": {
        "frame": {
          "enum": [
            "QVGA",
            "VGA",
            "SVGA",
            "XGA",
            "HD",
            "SXGA",
            "UXGA"
          ]
        },
        "quality": {
          "type": "integer",
          "minimum": 4,
          "maximum": 63
        },
        "burst": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "burst_interval_ms": {
          "type": "integer",
          "minimum": 0
        },
        "ir_led": {
          "enum": [
            "auto",
            "on",
            "off"
          ]
        }
      },
      "additionalProperties": false
    },
    "upload": {
      "type": "object",
      "required": [
        "primary"
      ],
      "properties": {
        "primary": {
          "type": "string",
          "format": "uri"
        },
        "fallback": {
          "type": "string",
          "format": "uri"
        }
      },
      "additionalProperties": false
    },
    "hw": {
      "description": "Board wiring; omitted fields keep the firmware defaults for the board",
      "type": "object",
      "properties": {
        "onewire_pin": {
          "type": "integer",
          "minimum": 0,
          "maximum": 48
        },
        "sda_pin": {
          "type": "integer",
          "minimum": 0,
          "maximum": 48
        },
        "scl_pin": {
          "type": "integer",
          "minimum": 0,
          "maximum": 48
        },
        "relay_pin": {
          "type": "integer",
          "minimum": 0,
          "maximum": 48
        },
        "relay_active_low": {
          "type": "boolean"
        },
        "button_pin": {
          "type": "integer",
          "minimum": 0,
          "maximum": 48
        },
        "led_pin": {
          "type": "integer",
          "minimum": 0,
          "maximum": 48
        },
        "vbat_pin": {
          "type": "integer",
          "minimum": 0,
          "maximum": 48,
          "description": "ADC pin with a voltage divider from the battery (roles meteo and relay; ESP8266 always reads A0 = 17)"
        },
        "vbat_ratio": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Divider ratio (R1+R2)/R2, e.g. 5.7 for 47k/10k: battery V = pin V x ratio"
        }
      },
      "additionalProperties": false
    },
    "relay": {
      "type": "object",
      "properties": {
        "channel": {
          "$ref": "common.schema.json#/$defs/segment"
        },
        "max_on_s": {
          "type": "integer",
          "minimum": 0,
          "description": "0 = no limit; the relay switches off by itself after this"
        }
      },
      "additionalProperties": false
    },
    "display": {
      "type": "object",
      "description": "Small local screen (0.42\" OLED): up to two metrics, large",
      "properties": {
        "lines": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "$ref": "common.schema.json#/$defs/segment"
          }
        }
      },
      "additionalProperties": false
    },
    "ble": {
      "description": "Role ble: the Bluetooth LE thermometer the hornet is a bridge for (Inkbird IHT-2PB)",
      "type": "object",
      "properties": {
        "mac": {
          "type": "string",
          "pattern": "^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$",
          "description": "Bluetooth address of the thermometer; without it the hornet scans and lists what it hears in its log"
        },
        "dump": {
          "type": "boolean",
          "description": "Put the raw notification frames in the hornet's log (to check the decoding against the thermometer's own app)"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
