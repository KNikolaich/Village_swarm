{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://village-swarm.local/contracts/v1/config.schema.json",
  "title": "vs/v1/dev/{id}/config (retained, hive -> hornet). Sections a role does not use are omitted",
  "type": "object",
  "required": ["v", "rev", "name", "health_interval_s"],
  "properties": {
    "v": { "const": 1 },
    "rev": { "type": "integer", "minimum": 0 },
    "name": { "type": "string", "minLength": 1, "description": "Human name, may be Cyrillic" },
    "health_interval_s": { "type": "integer", "minimum": 10 },
    "tele_interval_s": { "type": "integer", "minimum": 1 },
    "failsafe": {
      "type": "object",
      "properties": {
        "heater": {
          "type": "object",
          "required": ["min_c", "max_c", "max_on_s"],
          "properties": {
            "min_c": { "type": "number" },
            "max_c": { "type": "number" },
            "max_on_s": { "type": "integer", "minimum": 1 },
            "sensor": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "guard": {
      "type": "object",
      "properties": {
        "armed": { "type": "boolean" },
        "cooldown_s": { "type": "integer", "minimum": 0 },
        "record_when_disarmed": { "type": "boolean" },
        "check_photo_every_min": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "camera": {
      "type": "object",
      "properties": {
        "frame": { "enum": ["QVGA", "VGA", "SVGA", "XGA", "HD", "SXGA", "UXGA"] },
        "quality": { "type": "integer", "minimum": 4, "maximum": 63 },
        "burst": { "type": "integer", "minimum": 1, "maximum": 10 },
        "burst_interval_ms": { "type": "integer", "minimum": 0 },
        "ir_led": { "enum": ["auto", "on", "off"] }
      },
      "additionalProperties": false
    },
    "upload": {
      "type": "object",
      "required": ["primary"],
      "properties": {
        "primary": { "type": "string", "format": "uri" },
        "fallback": { "type": "string", "format": "uri" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
